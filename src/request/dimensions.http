### Variables
@base_url = http://localhost:3001/api

### ============================================
### GET - Listar todas las dimensiones
### ============================================
GET {{base_url}}/dimensions

### ============================================
### GET - Obtener dimensión por ID (existente)
### ============================================
GET {{base_url}}/dimensions/1

### ============================================
### GET - Obtener dimensión por ID (no existe)
### ============================================
GET {{base_url}}/dimensions/999

### ============================================
### GET - Obtener dimensión por ID (ID inválido)
### ============================================
GET {{base_url}}/dimensions/abc

### ============================================
### GET - Obtener dimensión por ID (ID negativo)
### ============================================
GET {{base_url}}/dimensions/-1

### ============================================
### POST - Crear dimensión válida (con stackConfig)
### ============================================
POST {{base_url}}/dimensions
Content-Type: application/json

{
  "thickness": 25,
  "width": 80,
  "length": 3200,
  "stackConfig": {
    "widthStack": 12,
    "heightStack": 20,
    "separatorEvery": 5
  }
}

### ============================================
### POST - Crear dimensión (falta thickness)
### ============================================
POST {{base_url}}/dimensions
Content-Type: application/json

{
  "width": 80,
  "length": 3200,
  "stackConfig": {
    "widthStack": 12,
    "heightStack": 20
  }
}

### ============================================
### POST - Crear dimensión (falta stackConfig)
### ============================================
POST {{base_url}}/dimensions
Content-Type: application/json

{
  "thickness": 25,
  "width": 80,
  "length": 3200
}

### ============================================
### POST - Crear dimensión (stackConfig incompleto)
### ============================================
POST {{base_url}}/dimensions
Content-Type: application/json

{
  "thickness": 25,
  "width": 80,
  "length": 3200,
  "stackConfig": {
    "widthStack": 12
  }
}

### ============================================
### POST - Crear dimensión (body vacío)
### ============================================
POST {{base_url}}/dimensions
Content-Type: application/json

{}

### ============================================
### POST - Crear dimensión (valores negativos)
### ============================================
POST {{base_url}}/dimensions
Content-Type: application/json

{
  "thickness": -10,
  "width": 80,
  "length": 3200,
  "stackConfig": {
    "widthStack": 12,
    "heightStack": 20
  }
}

### ============================================
### POST - Crear dimensión (valores decimales)
### ============================================
POST {{base_url}}/dimensions
Content-Type: application/json

{
  "thickness": 25.5,
  "width": 80,
  "length": 3200,
  "stackConfig": {
    "widthStack": 12,
    "heightStack": 20
  }
}

### ============================================
### POST - Crear dimensión (duplicada activa)
### ============================================
POST {{base_url}}/dimensions
Content-Type: application/json

{
  "thickness": 45,
  "width": 70,
  "length": 3200,
  "stackConfig": {
    "widthStack": 15,
    "heightStack": 14
  }
}

### ============================================
### PUT - Actualizar dimensión (todos los campos)
### ============================================
PUT {{base_url}}/dimensions/1
Content-Type: application/json

{
  "thickness": 30,
  "width": 90,
  "length": 3500
}

### ============================================
### PUT - Actualizar dimensión (falta un campo)
### ============================================
PUT {{base_url}}/dimensions/1
Content-Type: application/json

{
  "thickness": 30,
  "width": 90
}

### ============================================
### PUT - Actualizar dimensión (body vacío)
### ============================================
PUT {{base_url}}/dimensions/1
Content-Type: application/json

{}

### ============================================
### PUT - Actualizar dimensión (ID no existe)
### ============================================
PUT {{base_url}}/dimensions/999
Content-Type: application/json

{
  "thickness": 30,
  "width": 90,
  "length": 3500
}

### ============================================
### PUT - Actualizar dimensión (valor inválido)
### ============================================
PUT {{base_url}}/dimensions/1
Content-Type: application/json

{
  "thickness": -5,
  "width": 90,
  "length": 3500
}

### ============================================
### PATCH - Actualizar dimensión (un campo)
### ============================================
PATCH {{base_url}}/dimensions/1
Content-Type: application/json

{
  "thickness": 35
}

### ============================================
### PATCH - Actualizar dimensión (dos campos)
### ============================================
PATCH {{base_url}}/dimensions/1
Content-Type: application/json

{
  "thickness": 35,
  "width": 95
}

### ============================================
### PATCH - Actualizar dimensión (body vacío)
### ============================================
PATCH {{base_url}}/dimensions/1
Content-Type: application/json

{}

### ============================================
### PATCH - Actualizar dimensión (ID no existe)
### ============================================
PATCH {{base_url}}/dimensions/999
Content-Type: application/json

{
  "thickness": 35
}

### ============================================
### PATCH - Actualizar dimensión (valor inválido)
### ============================================
PATCH {{base_url}}/dimensions/1
Content-Type: application/json

{
  "thickness": -5
}

### ============================================
### DELETE - Eliminar dimensión (soft delete)
### ============================================
DELETE {{base_url}}/dimensions/1

### ============================================
### DELETE - Eliminar dimensión ya borrada
### ============================================
DELETE {{base_url}}/dimensions/1

### ============================================
### DELETE - Eliminar dimensión (ID no existe)
### ============================================
DELETE {{base_url}}/dimensions/999

### ============================================
### DELETE - Eliminar dimensión (ID inválido)
### ============================================
DELETE {{base_url}}/dimensions/abc

### ============================================
### POST - Restaurar dimensión eliminada (explícito)
### ============================================
POST {{base_url}}/dimensions/1/restore

### ============================================
### POST - Restaurar dimensión no eliminada (error)
### ============================================
POST {{base_url}}/dimensions/2/restore

### ============================================
### POST - Restaurar dimensión que no existe
### ============================================
POST {{base_url}}/dimensions/999/restore

### ============================================
### POST - Restore implícito (crear → borrar → crear misma)
### ============================================
### Paso 1: Crear dimensión
POST {{base_url}}/dimensions
Content-Type: application/json

{
  "thickness": 99,
  "width": 99,
  "length": 9999,
  "stackConfig": {
    "widthStack": 10,
    "heightStack": 10
  }
}

### Paso 2: Eliminarla (anotar el ID de la respuesta anterior y reemplazar)
DELETE {{base_url}}/dimensions/18

### Paso 3: Intentar crear la misma dimensión (debería restaurar la eliminada)
POST {{base_url}}/dimensions
Content-Type: application/json

{
  "thickness": 99,
  "width": 99,
  "length": 9999,
  "stackConfig": {
    "widthStack": 10,
    "heightStack": 10
  }
}
