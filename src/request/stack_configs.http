### Variables
@base_url = http://localhost:3001/api

### ============================================
### GET - Listar todas las configuraciones de apilado
### ============================================
GET {{base_url}}/stack-configs

### ============================================
### GET - Obtener configuración por ID (existente)
### ============================================
GET {{base_url}}/stack-configs/1

### ============================================
### GET - Obtener configuración por ID (no existe)
### ============================================
GET {{base_url}}/stack-configs/999

### ============================================
### GET - Obtener configuración por ID (ID inválido)
### ============================================
GET {{base_url}}/stack-configs/abc

### ============================================
### GET - Obtener configuración por ID (ID negativo)
### ============================================
GET {{base_url}}/stack-configs/-1

### ============================================
### POST - Crear configuración válida
### ============================================
POST {{base_url}}/stack-configs
Content-Type: application/json

{
  "widthStack": 12,
  "heightStack": 20,
  "separatorEvery": 5
}

### ============================================
### POST - Crear configuración (falta widthStack)
### ============================================
POST {{base_url}}/stack-configs
Content-Type: application/json

{
  "heightStack": 20,
  "separatorEvery": 5
}

### ============================================
### POST - Crear configuración (falta heightStack)
### ============================================
POST {{base_url}}/stack-configs
Content-Type: application/json

{
  "widthStack": 12,
  "separatorEvery": 5
}

### ============================================
### POST - Crear configuración (body vacío)
### ============================================
POST {{base_url}}/stack-configs
Content-Type: application/json

{}

### ============================================
### POST - Crear configuración (valores negativos)
### ============================================
POST {{base_url}}/stack-configs
Content-Type: application/json

{
  "widthStack": -5,
  "heightStack": 20,
  "separatorEvery": 5
}

### ============================================
### POST - Crear configuración (valores decimales)
### ============================================
POST {{base_url}}/stack-configs
Content-Type: application/json

{
  "widthStack": 12.5,
  "heightStack": 20,
  "separatorEvery": 5
}

### ============================================
### POST - Crear configuración (sin separatorEvery, usa default)
### ============================================
POST {{base_url}}/stack-configs
Content-Type: application/json

{
  "widthStack": 15,
  "heightStack": 25
}

### ============================================
### POST - Crear configuración (duplicada activa)
### ============================================
POST {{base_url}}/stack-configs
Content-Type: application/json

{
  "widthStack": 15,
  "heightStack": 14,
  "separatorEvery": 14
}

### ============================================
### PUT - Actualizar configuración (todos los campos)
### ============================================
PUT {{base_url}}/stack-configs/1
Content-Type: application/json

{
  "widthStack": 18,
  "heightStack": 16,
  "separatorEvery": 4
}

### ============================================
### PUT - Actualizar configuración (falta un campo)
### ============================================
PUT {{base_url}}/stack-configs/1
Content-Type: application/json

{
  "widthStack": 18,
  "heightStack": 16
}

### ============================================
### PUT - Actualizar configuración (body vacío)
### ============================================
PUT {{base_url}}/stack-configs/1
Content-Type: application/json

{}

### ============================================
### PUT - Actualizar configuración (ID no existe)
### ============================================
PUT {{base_url}}/stack-configs/999
Content-Type: application/json

{
  "widthStack": 18,
  "heightStack": 16,
  "separatorEvery": 4
}

### ============================================
### PUT - Actualizar configuración (valor inválido)
### ============================================
PUT {{base_url}}/stack-configs/1
Content-Type: application/json

{
  "widthStack": -5,
  "heightStack": 16,
  "separatorEvery": 4
}

### ============================================
### PATCH - Actualizar configuración (un campo)
### ============================================
PATCH {{base_url}}/stack-configs/1
Content-Type: application/json

{
  "widthStack": 20
}

### ============================================
### PATCH - Actualizar configuración (dos campos)
### ============================================
PATCH {{base_url}}/stack-configs/1
Content-Type: application/json

{
  "widthStack": 20,
  "heightStack": 18
}

### ============================================
### PATCH - Actualizar configuración (body vacío)
### ============================================
PATCH {{base_url}}/stack-configs/1
Content-Type: application/json

{}

### ============================================
### PATCH - Actualizar configuración (ID no existe)
### ============================================
PATCH {{base_url}}/stack-configs/999
Content-Type: application/json

{
  "widthStack": 20
}

### ============================================
### PATCH - Actualizar configuración (valor inválido)
### ============================================
PATCH {{base_url}}/stack-configs/1
Content-Type: application/json

{
  "heightStack": -3
}

### ============================================
### DELETE - Eliminar configuración (soft delete)
### ============================================
DELETE {{base_url}}/stack-configs/1

### ============================================
### DELETE - Eliminar configuración ya borrada
### ============================================
DELETE {{base_url}}/stack-configs/1

### ============================================
### DELETE - Eliminar configuración (ID no existe)
### ============================================
DELETE {{base_url}}/stack-configs/999

### ============================================
### DELETE - Eliminar configuración (ID inválido)
### ============================================
DELETE {{base_url}}/stack-configs/abc

### ============================================
### DELETE - Eliminar configuración usada como default (error)
### ============================================
DELETE {{base_url}}/stack-configs/2

### ============================================
### POST - Restaurar configuración eliminada (explícito)
### ============================================
POST {{base_url}}/stack-configs/1/restore

### ============================================
### POST - Restaurar configuración no eliminada (error)
### ============================================
POST {{base_url}}/stack-configs/2/restore

### ============================================
### POST - Restaurar configuración que no existe
### ============================================
POST {{base_url}}/stack-configs/999/restore

### ============================================
### POST - Restore implícito (crear → borrar → crear misma)
### ============================================
### Paso 1: Crear configuración nueva
POST {{base_url}}/stack-configs
Content-Type: application/json

{
  "widthStack": 99,
  "heightStack": 99,
  "separatorEvery": 10
}

### Paso 2: Eliminarla (reemplazar el ID con el de la respuesta anterior)
DELETE {{base_url}}/stack-configs/20

### Paso 3: Intentar crear la misma configuración (debería restaurar la eliminada)
POST {{base_url}}/stack-configs
Content-Type: application/json

{
  "widthStack": 99,
  "heightStack": 99,
  "separatorEvery": 10
}
