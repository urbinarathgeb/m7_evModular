### Variables
@base_url = http://localhost:3001/api

### Nota: El seed inicial crea 3 órdenes:
###   - Order 1 (pending):       Juan Pérez, dims: 45x70x3200 qty10, 18x100x3200 qty5
###   - Order 2 (in_production): Maderas del Sur, dims: 90x100x3200 qty6, 18x90x3200 qty8, 45x70x3200 qty3
###   - Order 3 (completed):     Constructora del Norte, dim: 70x90x3200 qty4
### Orders 4+ son creadas por los tests POST más abajo.

### ============================================
### GET - Listar todas las órdenes
### ============================================
GET {{base_url}}/orders

### ============================================
### GET - Obtener orden seed 1 (pending)
### ============================================
GET {{base_url}}/orders/1

### ============================================
### GET - Obtener orden seed 2 (in_production)
### ============================================
GET {{base_url}}/orders/2

### ============================================
### GET - Obtener orden seed 3 (completed)
### ============================================
GET {{base_url}}/orders/3

### ============================================
### GET - Obtener orden por ID (no existe)
### ============================================
GET {{base_url}}/orders/999

### ============================================
### GET - Obtener orden por ID (ID inválido)
### ============================================
GET {{base_url}}/orders/abc

### ============================================
### POST - Crear orden válida (sin fecha, status default pending)
### ============================================
POST {{base_url}}/orders
Content-Type: application/json

{
  "client": "Juan Pérez",
  "dimensions": [
    { "dimensionId": 1, "quantity": 5 },
    { "dimensionId": 3, "quantity": 10 }
  ]
}

### ============================================
### POST - Crear orden con fecha DD-MM-YYYY
### ============================================
POST {{base_url}}/orders
Content-Type: application/json

{
  "client": "María González",
  "orderDate": "28-05-2026",
  "dimensions": [
    { "dimensionId": 2, "quantity": 3 }
  ]
}

### ============================================
### POST - Crear orden (falta client)
### ============================================
POST {{base_url}}/orders
Content-Type: application/json

{
  "dimensions": [
    { "dimensionId": 1, "quantity": 5 }
  ]
}

### ============================================
### POST - Crear orden (falta dimensions)
### ============================================
POST {{base_url}}/orders
Content-Type: application/json

{
  "client": "Juan Pérez"
}

### ============================================
### POST - Crear orden (dimensions vacío)
### ============================================
POST {{base_url}}/orders
Content-Type: application/json

{
  "client": "Juan Pérez",
  "dimensions": []
}

### ============================================
### POST - Crear orden (dimensionId inválido)
### ============================================
POST {{base_url}}/orders
Content-Type: application/json

{
  "client": "Juan Pérez",
  "dimensions": [
    { "dimensionId": -1, "quantity": 5 }
  ]
}

### ============================================
### POST - Crear orden (quantity inválida)
### ============================================
POST {{base_url}}/orders
Content-Type: application/json

{
  "client": "Juan Pérez",
  "dimensions": [
    { "dimensionId": 1, "quantity": 0 }
  ]
}

### ============================================
### POST - Crear orden (fecha formato incorrecto)
### ============================================
POST {{base_url}}/orders
Content-Type: application/json

{
  "client": "Juan Pérez",
  "orderDate": "2026-05-28",
  "dimensions": [
    { "dimensionId": 1, "quantity": 5 }
  ]
}

### ============================================
### POST - Crear orden (dimensionId no existe)
### ============================================
POST {{base_url}}/orders
Content-Type: application/json

{
  "client": "Juan Pérez",
  "dimensions": [
    { "dimensionId": 999, "quantity": 5 }
  ]
}

### ============================================
### PUT - Actualizar orden (todos los campos)
### ============================================
PUT {{base_url}}/orders/1
Content-Type: application/json

{
  "client": "Carlos López",
  "orderDate": "30-05-2026",
  "status": "in_production"
}

### ============================================
### PUT - Actualizar orden (falta status)
### ============================================
PUT {{base_url}}/orders/1
Content-Type: application/json

{
  "client": "Carlos López",
  "orderDate": "30-05-2026"
}

### ============================================
### PUT - Actualizar orden (status inválido)
### ============================================
PUT {{base_url}}/orders/1
Content-Type: application/json

{
  "client": "Carlos López",
  "orderDate": "30-05-2026",
  "status": "invalid_status"
}

### ============================================
### PUT - Actualizar orden (fecha formato incorrecto)
### ============================================
PUT {{base_url}}/orders/1
Content-Type: application/json

{
  "client": "Carlos López",
  "orderDate": "2026-05-30",
  "status": "pending"
}

### ============================================
### PATCH - Actualizar orden (solo client)
### ============================================
PATCH {{base_url}}/orders/1
Content-Type: application/json

{
  "client": "Pedro Martínez"
}

### ============================================
### PATCH - Actualizar orden (solo status)
### ============================================
PATCH {{base_url}}/orders/1
Content-Type: application/json

{
  "status": "completed"
}

### ============================================
### PATCH - Actualizar orden (solo orderDate)
### ============================================
PATCH {{base_url}}/orders/1
Content-Type: application/json

{
  "orderDate": "01-06-2026"
}

### ============================================
### PATCH - Actualizar orden (body vacío)
### ============================================
PATCH {{base_url}}/orders/1
Content-Type: application/json

{}

### ============================================
### PATCH - Actualizar orden (ID no existe)
### ============================================
PATCH {{base_url}}/orders/999
Content-Type: application/json

{
  "client": "Nuevo Cliente"
}

### ============================================
### DELETE - Eliminar orden (soft delete)
### ============================================
DELETE {{base_url}}/orders/1

### ============================================
### DELETE - Eliminar orden ya borrada
### ============================================
DELETE {{base_url}}/orders/1

### ============================================
### DELETE - Eliminar orden (ID no existe)
### ============================================
DELETE {{base_url}}/orders/999

### ============================================
### POST - Restaurar orden eliminada (explícito)
### ============================================
POST {{base_url}}/orders/1/restore

### ============================================
### POST - Restaurar orden seed 2 (no eliminada, debe dar error)
### ============================================
POST {{base_url}}/orders/2/restore

### ============================================
### POST - Restaurar orden que no existe
### ============================================
POST {{base_url}}/orders/999/restore
